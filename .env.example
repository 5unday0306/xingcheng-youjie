# Local template only. Do not overwrite an existing .env. Never commit .env.
# AMap: use a Web Service key, not a JavaScript API key.
AMAP_WEB_SERVICE_KEY=
DEEPSEEK_API_KEY=

# Task05 preparation: runtime support is not implemented yet.
# JS API key is browser-visible by design; restrict it in the AMap console.
AMAP_JS_KEY=
# Paired JS security code: server only, injected by the restricted proxy.
AMAP_JS_SECURITY_CODE=
