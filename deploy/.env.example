# Copy to deploy/.env on the server only. Do not commit or paste secrets into chat.
APP_DOMAIN=travel.example.com
MAP_DOMAIN=map.example.com
ACME_EMAIL=
REVIEW_USER=reviewer
# Generate interactively: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Use SINGLE QUOTES around the bcrypt hash so Compose preserves literal $ characters.
REVIEW_PASSWORD_HASH=''
AMAP_WEB_SERVICE_KEY=
DEEPSEEK_API_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
